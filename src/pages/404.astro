---
import Layout from '@/layouts/Layout.astro'
import { Header } from '@/components/header/Header'
import Footer from '@/components/footer/Footer.astro'
import { Provider } from '@/components/provider/Provider'
import { getAllCategories, getHotTags } from '@/utils/content'

const categories = await getAllCategories()
const hotTags = await getHotTags(4)
---

<Layout title="404 - 迷失在虚空中">
  <Provider pathName="/404" client:only="react" />
  <Header client:only="react" />

  <main class="relative z-1 pt-24 pb-16 min-h-main flex items-center justify-center px-4">
    <div
      class="w-full max-w-[680px] glass-card p-8 md:p-12 text-center relative overflow-hidden shadow-2xl"
    >
      <!-- 柔光氛围光晕 -->
      <div
        class="absolute -top-24 -left-24 size-48 rounded-full bg-accent/20 blur-3xl pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute -bottom-24 -right-24 size-48 rounded-full bg-sky-400/20 blur-3xl pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <!-- 宇宙飞船浮动图标 -->
      <div
        class="inline-flex items-center justify-center size-20 rounded-2xl bg-accent/10 border border-accent/20 text-accent mb-6 shadow-inner animate-bounce [animation-duration:3s]"
      >
        <svg
          class="size-10"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
          ></path>
        </svg>
      </div>

      <!-- 404 炫彩渐变大字 -->
      <h1
        class="text-7xl md:text-8xl font-black tracking-tight leading-none mb-3 bg-gradient-to-r from-accent via-sky-400 to-indigo-400 bg-clip-text text-transparent select-none drop-shadow-sm"
      >
        404
      </h1>

      <!-- 主标题与治愈文案 -->
      <h2 class="text-xl md:text-2xl font-bold text-primary mb-3">迷航信号：目标星区未响应</h2>
      <p class="text-sm md:text-base text-secondary max-w-[500px] mx-auto leading-relaxed mb-8">
        这片坐标似乎空无一物，也许信号已被微引力透镜偏折，或者该舱段已经迁往了新的星轨。没关系，深空漫游本就是一场充满未知的偶遇。
      </p>

      <!-- 核心导航按钮组 -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 mb-10">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-accent text-white font-medium text-sm shadow-lg shadow-accent/25 hover:shadow-accent/40 hover:scale-[1.03] active:scale-[0.98] transition-all"
        >
          <i class="iconfont icon-arrow-left-up text-base"></i>
          <span>返回母港首页</span>
        </a>
        <a
          href="/archives"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-secondary/70 hover:bg-secondary text-primary font-medium text-sm border border-primary/20 hover:scale-[1.03] active:scale-[0.98] transition-all"
        >
          <i class="iconfont icon-archive text-base"></i>
          <span>查阅航行日志</span>
        </a>
      </div>

      <!-- 探索备用推荐航道 -->
      {
        (categories.length > 0 || hotTags.length > 0) && (
          <div class="pt-6 border-t border-primary/15 text-xs text-secondary">
            <div class="mb-3 opacity-80">或者从这些航道重新出发：</div>
            <div class="flex flex-wrap items-center justify-center gap-2">
              {categories.slice(0, 3).map((c) => (
                <a
                  href={`/categories/${c.slug}`}
                  class="px-3 py-1 rounded-lg bg-secondary/40 hover:bg-accent/10 hover:text-accent border border-primary/10 transition-colors"
                >
                  分类 · {c.name}
                </a>
              ))}
              {hotTags.slice(0, 3).map((t) => (
                <a
                  href={`/tags/${t.slug}`}
                  class="px-3 py-1 rounded-lg bg-secondary/40 hover:bg-accent/10 hover:text-accent border border-primary/10 transition-colors"
                >
                  #{t.name}
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </main>

  <Footer />
</Layout>
